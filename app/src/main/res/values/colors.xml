    <!--
      Redesign tokens. The hero card is a fixed brand-coloured surface: it keeps the same
      indigo fill in both themes, so it is not a light/dark pair.
    -->
    <color name="hero_surface">#535CA8</color>
    <color name="hero_on_surface">#FFFFFF</color>
    <color name="hero_on_surface_muted">#B8FFFFFF</color>
    <color name="hero_on_surface_faint">#38FFFFFF</color>
    <color name="hero_negative">#E4A89C</color>
    <color name="hero_track">#38FFFFFF</color>

    <!-- Hairline outline for unselected chips and quick-start row, 1dp. -->
    <color name="md_theme_light_hairline">#d4d7de</color>
    <color name="md_theme_dark_hairline">#2b2e33</color>

    <!--
      Red suits. A warm terracotta rather than colorError: a suit is information, not an
      alarm, and this keeps it clear of the pink used for negative scores.
    -->
    <color name="md_theme_light_suit_red">#a95d4c</color>
    <color name="md_theme_dark_suit_red">#E4A89C</color>

    <!--
      Chart series colours, one per seat in table order. Separated by hue rather than by
      lightness so the three lines stay tellable apart in both themes.
    -->
    <color name="md_theme_light_chart_series_1">#535CA8</color>
    <color name="md_theme_light_chart_series_2">#a95d4c</color>
    <color name="md_theme_light_chart_series_3">#3F6B44</color>
