<?xml version="1.0" encoding="utf-8"?>
<!--
  Stands in for the hero card when nothing is running but earlier lists are still on the
  screen. It keeps the slot filled with something tappable - the same new-list sheet the
  centre button opens - rather than leaving a stray line of grey text above quick start.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.OutlinedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

        <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_add_24dp"
                app:tint="?attr/colorPrimary" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_no_running_list"
                    android:textAppearance="@style/TextAppearance.App.RowTitle" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/text_no_running_list"
                    android:textAppearance="@style/TextAppearance.App.MetaSmall" />

        </LinearLayout>

    </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
