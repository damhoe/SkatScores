# Copy to keystore.properties (git-ignored) and fill in. Paths are relative to the project root.
# Create the upload key once with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 4096 -validity 10000 -alias upload
# Keep the .jks and these passwords backed up outside the repository.
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
