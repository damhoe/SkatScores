<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".app.HomeFragment">

        <FrameLayout
                android:id="@+id/image_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@id/guideline"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/toolbar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="?attr/toolbarBackground" />

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="-36dp"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/guideline">

            <FrameLayout
                    android:id="@+id/headerBackground"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:background="@drawable/library_overflow_background"
                    app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                    android:id="@+id/headerShadow"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:alpha="0.0"
                    android:background="@drawable/gradient_fade_top"
                    android:translationZ="1dp"
                    app:layout_constraintTop_toBottomOf="@id/headerBackground" />

            <TextView
                    android:id="@+id/lists_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/title_library"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/scrollingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    android:descendantFocusability="blocksDescendants"
                    android:nestedScrollingEnabled="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/headerBackground">

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/games_rv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="36dp"
                        android:layout_marginEnd="36dp"
                        android:clipToPadding="false"
                        android:minHeight="100dp"
                        android:overScrollMode="always"
                        android:paddingBottom="8dp"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_game_preview" />

                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/addButton"
                        style="@style/Widget.Material3.FloatingActionButton.Large.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="@dimen/fab_margin_right"
                        android:layout_marginBottom="@dimen/fab_margin_bottom"
                        android:text="@string/title_new_game"
                        app:icon="@drawable/ic_add_24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

            </androidx.coordinatorlayout.widget.CoordinatorLayout>

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/statisticsButton"
                    style="@style/Widget.App.IconButton.Tertiary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="36dp"
                    app:icon="@drawable/ic_bar_chart_24dp"
                    app:iconSize="32dp"
                    app:layout_constraintBottom_toBottomOf="@id/lists_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/lists_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.28" />

        <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.App.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />

        </com.google.android.material.appbar.MaterialToolbar>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>