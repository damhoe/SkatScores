    -->
    <style name="Theme.App.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- No android:fontFamily here either; the scale carries it. -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.M3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.M3.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.M3.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.M3.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.M3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.M3.LabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="titleTextColor">?attr/colorPrimary</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="materialIconButtonOutlinedStyle">@style/Widget.App.Button.ToggleGroupIconButton.Dark</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.OutlinedButton</item>
        <item name="chipStyle">@style/Widget.App.Chip.Suggestion</item>
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>
        <item name="collapsingToolbarLayoutStyle">@style/Widget.App.CollapsingToolbar</item>
        <item name="coloredAppBarLayoutStyle">@style/Widget.App.AppBarLayout.Colored.Dark</item>
        <item name="coloredToolbarStyle">@style/Widget.App.Toolbar.Colored.Dark</item>
    </style>

    <!--
      ============ Material 3 type scale ============

      Material's own text appearances hard-set the family: every
      TextAppearance.M3.Sys.Typescale.* declares fontFamily and android:fontFamily as
      @string/m3_ref_typeface_plain_regular (Roboto). A theme-level android:fontFamily reaches
      plain TextViews but never reaches a component, because a component takes its appearance
      from the type scale - MaterialButton and Chip both resolve android:textAppearance to
      ?attr/textAppearanceLabelLarge - and the appearance names a family of its own.

      So re-facing the app means repointing the fifteen scale attributes, not setting one font
      on the theme. These styles change nothing but the family; sizes, tracking and line
      heights stay on Material's values.

      The .Emphasized variants that Material 1.13 adds are deliberately left alone: nothing in
      the app resolves to one. Override them here as well if that changes.
    -->

    <style name="TextAppearance.App.M3.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
