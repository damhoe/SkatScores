<?xml version="1.0" encoding="utf-8"?>
<!--
  Saved players. A peer of home rather than a sub-screen, so it carries the same floating
  bottom bar with the two tabs and a centre FAB - here the FAB adds a player.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            tools:context=".player.adapter.presentation.PlayersFragment">

        <LinearLayout
                android:id="@+id/appBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/backButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/description_close"
                    app:icon="@drawable/ic_arrow_back_24dp" />

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/title_players"
                    android:textAppearance="@style/TextAppearance.App.AppBarTitle" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/player_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:paddingBottom="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appBar"
                tools:itemCount="6"
                tools:listitem="@layout/item_player" />

        <TextView
                android:id="@+id/text_no_players"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:gravity="center"
                android:text="@string/text_info_no_players"
                android:textAppearance="@style/TextAppearance.App.Meta"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/player_recycler_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/player_recycler_view"
                tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottomPill"
                style="@style/Widget.App.BottomPill"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/bottom_pill_side_margin"
                android:layout_marginEnd="@dimen/bottom_pill_side_margin"
                android:layout_marginBottom="@dimen/bottom_pill_bottom_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/listsTab"
                        style="@style/Widget.App.BottomPill.Tab"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/title_library"
                        android:textColor="?attr/colorOutline"
                        app:icon="@drawable/ic_lists_24dp"
                        app:iconTint="?attr/colorOutline" />

                <!-- Cradle for the centre button. -->
                <Space
                        android:layout_width="@dimen/bottom_pill_cradle_width"
                        android:layout_height="match_parent" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/playersTab"
                        style="@style/Widget.App.BottomPill.Tab"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/title_players_short"
                        android:textColor="?attr/colorPrimary"
                        app:icon="@drawable/ic_people_24dp"
                        app:iconTint="?attr/colorPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/addPlayerButton"
                style="@style/Widget.App.CenterFab"
                android:contentDescription="@string/description_create_new_profile"
                app:icon="@drawable/ic_person_add_24dp"
                app:layout_constraintBottom_toBottomOf="@id/bottomPill"
                app:layout_constraintEnd_toEndOf="@id/bottomPill"
                app:layout_constraintStart_toStartOf="@id/bottomPill"
                app:layout_constraintTop_toTopOf="@id/bottomPill" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
