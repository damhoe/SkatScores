<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/game_side_padding"
        android:paddingTop="11dp"
        android:paddingEnd="@dimen/score_row_end_padding"
        android:paddingBottom="11dp">

    <TextView
            android:id="@+id/round_text"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.App.NumberSmall"
            android:textColor="?attr/colorOutlineVariant"
            tools:text="9" />

    <TextView
            android:id="@+id/partyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="46dp"
            android:textAppearance="@style/TextAppearance.App.MetaSmall"
            tools:text="Re" />

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/roundTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.RoundTitle"
                tools:text="Solo · Damen" />

        <TextView
                android:id="@+id/roundSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.MetaSmall"
                tools:text="Marlon, Evi · &lt; 60 · Re" />

    </LinearLayout>

    <TextView
            android:id="@+id/roundValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textAppearance="@style/TextAppearance.App.RoundValue"
            tools:text="+3" />

</LinearLayout>
