<?xml version="1.0" encoding="utf-8"?>
<!-- Selection chip fill: primary when selected, neutral container otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/colorPrimary" />
    <item android:state_enabled="false" android:alpha="0.38" android:color="?attr/colorSurfaceContainerHigh" />
    <item android:color="?attr/colorSurfaceContainerHigh" />
</selector>
