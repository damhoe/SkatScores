<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and up. Everything the app keeps is worth keeping: the lists, rounds and players
    (the database, with its write-ahead log next to it) and the settings (DataStore and the
    chosen language, under files/). Nothing in it is secret or tied to the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
