<?xml version="1.0" encoding="utf-8"?>
<!--
  New Doppelkopf list, reached from the centre FAB on home while the Doppelkopf filter is
  selected: name, round count, scoring mode, Start.

  Who sits at the table is not asked here, the same as for a Skat list: the four seats start as
  placeholders and are filled in the game view, which is also where they can be changed later.

  Round-count chips are populated from DoppelkopfRoundCount.ALLOWED_VALUES at runtime rather
  than hardcoded here, so the sheet can only ever offer values the domain accepts. Those values
  are all multiples of four, so the deal comes back round to every seat the same number of
  times.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_sheet"
            android:clipToPadding="false">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

            <View
                    android:layout_width="38dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_drag_handle" />

            <!-- Header -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_new_doppelkopf_list"
                        android:textAppearance="@style/TextAppearance.App.AppBarTitle" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/closeButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/description_close"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_close_24dp"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorOutline" />

            </LinearLayout>

            <!-- List name -->
            <TextView
                    style="@style/Widget.App.Sheet.SectionLabel"
                    android:text="@string/title_list_name" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/listNameInput"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="20"
                    app:endIconMode="clear_text"
                    app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/listNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusedByDefault="false"
                        android:inputType="text"
                        android:maxLines="1"
                        tools:text="Doppelkopf 003" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Round count -->
            <TextView
                    style="@style/Widget.App.Sheet.SectionLabel"
                    android:text="@string/settingsRoundCountTitle" />

            <!-- Filled by the fragment: rows of three chips, one per allowed round count. -->
            <LinearLayout
                    android:id="@+id/roundCountRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            <!-- Scoring mode -->
            <TextView
                    style="@style/Widget.App.Sheet.SectionLabel"
                    android:text="@string/settingsScoringTitle" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/scoringSimple"
                        style="@style/Widget.App.Sheet.Chip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settingsDoppelkopfScoringSimple" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/scoringDetailed"
                        style="@style/Widget.App.Sheet.Chip"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/settingsDoppelkopfScoringDetailed" />

            </LinearLayout>

            <!-- The one setting that changes what a round is worth, so it says what it does. -->
            <TextView
                    android:id="@+id/scoringHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.Meta"
                    tools:text="Win, levels and announcements only." />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    style="@style/Widget.App.Sheet.SaveButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="20dp"
                    android:text="@string/settingsStartButton" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
