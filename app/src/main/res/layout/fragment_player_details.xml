<?xml version="1.0" encoding="utf-8"?>
<!--
  One player. Same shell as the rest of the app: 60dp header, 20dp gutters, actions as
  hairline rows rather than a stack of outlined buttons.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground">

        <LinearLayout
                android:id="@+id/appBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/backButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/description_close"
                    app:icon="@drawable/ic_arrow_back_24dp" />

            <TextView
                    android:id="@+id/headerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.AppBarTitle"
                    tools:text="Daniel D." />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appBar">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_side_padding"
                    android:paddingEnd="@dimen/screen_side_padding">

                <!--
                  Identity. No container: the avatar, name, count and date are the subject of
                  the screen rather than one item among several, so they sit straight on the
                  page and the card padding becomes plain vertical spacing.
                -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp">

                    <TextView
                            android:id="@+id/initial"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_avatar_tint"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.App.Initial.Profile"
                            tools:text="D" />

                    <TextView
                            android:id="@+id/name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.ProfileName"
                            tools:text="Daniel D." />

                    <TextView
                            android:id="@+id/number_games"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.App.ProfileCount"
                            tools:text="12 Listen" />

                    <TextView
                            android:id="@+id/created"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.App.Meta"
                            tools:text="Erstellt am 29.10.2023" />

                </LinearLayout>

                <!-- Actions -->
                <com.google.android.material.card.MaterialCardView
                        android:id="@+id/button_stats"
                        style="@style/Widget.App.OutlinedRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:clickable="true"
                        android:focusable="true">

                    <LinearLayout
                            style="@style/Widget.App.PlayerActionRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                        <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_bar_chart_24dp"
                                app:tint="?attr/colorPrimary" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/title_button_player_statistics"
                                android:textAppearance="@style/TextAppearance.App.RowTitle" />

                        <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_next_24dp"
                                app:tint="?attr/colorOutline" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                        android:id="@+id/edit_name"
                        style="@style/Widget.App.OutlinedRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true">

                    <LinearLayout
                            style="@style/Widget.App.PlayerActionRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                        <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_edit_24dp"
                                app:tint="?attr/colorPrimary" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/dialog_title_edit_player_name"
                                android:textAppearance="@style/TextAppearance.App.RowTitle" />

                        <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_next_24dp"
                                app:tint="?attr/colorOutline" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_delete"
                        style="@style/Widget.App.DangerButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="20dp"
                        android:text="@string/title_button_delete"
                        app:icon="@drawable/ic_delete_24dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
