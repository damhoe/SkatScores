<?xml version="1.0" encoding="utf-8"?>
<!--
  State layer for the bare icon buttons in the headers.

  The inherited text-button ripple is keyed to colorPrimary at a low alpha, which is all but
  invisible on a plain header. These are the M3 state-layer opacities over colorOnSurface, so
  a press reads as the circular ripple the platform draws everywhere else.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.12"
        android:color="?attr/colorOnSurface"
        android:state_pressed="true" />
    <item
        android:alpha="0.10"
        android:color="?attr/colorOnSurface"
        android:state_focused="true" />
    <item
        android:alpha="0.08"
        android:color="?attr/colorOnSurface"
        android:state_hovered="true" />
    <item
        android:alpha="0.0"
        android:color="?attr/colorOnSurface" />
</selector>
