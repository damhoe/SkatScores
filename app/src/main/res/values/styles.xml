<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.App" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimaryDark">?attr/colorSecondary</item>
        <!--
          No android:fontFamily here on purpose - see the type scale below. A family set on
          the theme is applied to a TextView as a direct attribute, which beats the text
          appearance and takes the appearance's weight and face down with it: it was
          flattening every android:textFontWeight in the app to regular and rendering the
          mono styles in the sans face. The scale carries the family instead.
        -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.M3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.M3.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.M3.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.M3.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.M3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.M3.LabelSmall</item>
        <item name="titleTextColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:listDivider">@drawable/list_divider</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="materialIconButtonOutlinedStyle">@style/Widget.App.Button.ToggleGroupIconButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.OutlinedButton</item>
        <item name="chipStyle">@style/Widget.App.Chip.Suggestion</item>
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>
        <item name="collapsingToolbarLayoutStyle">@style/Widget.App.CollapsingToolbar</item>
        <item name="coloredAppBarLayoutStyle">@style/Widget.App.AppBarLayout.Colored</item>
        <item name="coloredToolbarStyle">@style/Widget.App.Toolbar.Colored</item>
    </style>

    <!--
