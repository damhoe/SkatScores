<?xml version="1.0" encoding="utf-8"?>
<!--
  One row in "Recently played". The row itself opens the list; the old Fortsetzen and
  delete buttons are gone — delete is swipe-to-dismiss with an undo snackbar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/rowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_side_padding"
        android:paddingTop="11dp"
        android:paddingEnd="@dimen/screen_side_padding"
        android:paddingBottom="11dp">

    <TextView
            android:id="@+id/rounds"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_rounded_square_12"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.App.NumberBadge"
            tools:text="24" />

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.RowTitle"
                tools:text="Stammtisch 010" />

        <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Meta"
                tools:text="Sa, 21. Feb · Marlon, Evi, Daniel" />

    </LinearLayout>

    <TextView
            android:id="@+id/winnerDelta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="@style/TextAppearance.App.NumberInline"
            android:textColor="?attr/colorPrimary"
            tools:text="+412" />

</LinearLayout>
