<?xml version="1.0" encoding="utf-8"?>
<!--
  Text face for the redesigned screens: Geist (OFL).

  Four static weights rather than the variable TTF, so android:textFontWeight in
  redesign_styles.xml resolves to a real cut instead of a synthetic one. Italics are not
  shipped because nothing in the design uses them.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/geist_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/geist_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/geist_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/geist_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
