<?xml version="1.0" encoding="utf-8"?>
<!-- Modifier toggle: a translucent primary wash when on, transparent when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:alpha="0.16" android:color="?attr/colorPrimary" />
    <item android:color="@android:color/transparent" />
</selector>
