<?xml version="1.0" encoding="utf-8"?>
<!--
  Game screen: app bar, pinned scoreboard, newest-first round log, floating bottom bar.
  Replaces the 3-column table of dashes and its header/footer rows.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            tools:context=".game.skat.adapter.presentation.SkatGameFragment">

        <!--
          1. App bar. A single line: the round count used to be squeezed underneath the title
          and had no room to breathe, so it now lives in the scoreboard card where progress
          belongs anyway. That leaves the title on one comfortable baseline among the 44dp
          icon buttons.
        -->
        <LinearLayout
                android:id="@+id/appBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/returnButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/description_close"
                    app:icon="@drawable/ic_arrow_back_24dp" />

            <TextView
                    android:id="@+id/gameTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.AppBarTitle"
                    tools:text="Stammtisch 010" />

            <!--
              Actions on the list itself. The bottom pill is about the rounds, so sharing the
              list, who is playing it and its settings belong up here next to its name rather
              than mixed in among undo and the chart. Players get an icon of their own because
              a substitution mid-evening is the likeliest edit of the three.
            -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/description_share"
                    app:icon="@drawable/ic_share_24dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/playersButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/title_players"
                    app:icon="@drawable/ic_people_24dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/title_game_settings"
                    app:icon="@drawable/ic_settings_24dp" />

        </LinearLayout>

        <!-- 2. Pinned scoreboard -->
        <include
                android:id="@+id/scoreboard"
                layout="@layout/view_scoreboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/game_side_padding"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/game_side_padding"
                app:layout_constraintTop_toBottomOf="@id/appBar" />

        <!-- 3. Round log -->
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scoresRv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingBottom="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scoreboard"
                tools:itemCount="6"
                tools:listitem="@layout/item_score" />

        <TextView
                android:id="@+id/emptyRoundsHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:gravity="center"
                android:text="@string/text_no_rounds"
                android:textAppearance="@style/TextAppearance.App.Meta"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/scoresRv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/scoresRv"
                tools:visibility="visible" />

        <!--
          4. Bottom bar. Three round actions - look at them, add one, take the last one back -
          around a single axis. With one slot either side of the centre button the bar no longer
          has to span the screen to stay balanced, so it wraps its content and sits centred.
        -->
        <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottomPill"
                style="@style/Widget.App.BottomPill"
                android:layout_width="wrap_content"
                android:layout_marginBottom="@dimen/bottom_pill_bottom_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/chartAction"
                        style="@style/Widget.App.BottomPill.Action"
                        android:layout_width="@dimen/bottom_pill_action_width"
                        android:contentDescription="@string/title_statistics"
                        app:icon="@drawable/ic_chart_24dp" />

                <!-- Cradle for the centre button. -->
                <Space
                        android:layout_width="@dimen/bottom_pill_cradle_width"
                        android:layout_height="match_parent" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/undoAction"
                        style="@style/Widget.App.BottomPill.Action"
                        android:layout_width="@dimen/bottom_pill_action_width"
                        android:contentDescription="@string/description_undo"
                        app:icon="@drawable/ic_undo_24dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/editScoreButton"
                style="@style/Widget.App.CenterFab"
                android:contentDescription="@string/description_new_score"
                app:icon="@drawable/ic_add_24dp"
                app:layout_constraintBottom_toBottomOf="@id/bottomPill"
                app:layout_constraintEnd_toEndOf="@id/bottomPill"
                app:layout_constraintStart_toStartOf="@id/bottomPill"
                app:layout_constraintTop_toTopOf="@id/bottomPill" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
