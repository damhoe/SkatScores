<?xml version="1.0" encoding="utf-8"?>
<!--
  Doppelkopf game screen: app bar, pinned four-column scoreboard, newest-first round log,
  floating bottom bar. Same shape as the Skat screen, so the two games read the same way, but
  its own layout because the board carries four seats and the round rows say different things.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            tools:context=".game.doppelkopf.adapter.presentation.DoppelkopfGameFragment">

        <LinearLayout
                android:id="@+id/appBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/returnButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/description_close"
                    app:icon="@drawable/ic_arrow_back_24dp" />

            <TextView
                    android:id="@+id/gameTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.AppBarTitle"
                    tools:text="Doppelkopf 003" />

            <!--
              Actions on the list itself, mirroring the Skat screen: sharing the list, who is
              playing it and its settings sit next to its name, while the bottom pill stays
              about the rounds.
            -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/description_share"
                    app:icon="@drawable/ic_share_24dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/playersButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/title_players"
                    app:icon="@drawable/ic_people_24dp" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/settingsButton"
                    style="@style/Widget.App.AppBar.IconButton"
                    android:contentDescription="@string/title_game_settings"
                    app:icon="@drawable/ic_settings_24dp" />

        </LinearLayout>

        <include
                android:id="@+id/scoreboard"
                layout="@layout/view_doppelkopf_scoreboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/game_side_padding"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/game_side_padding"
                app:layout_constraintTop_toBottomOf="@id/appBar" />

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scoresRv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingBottom="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scoreboard"
                tools:itemCount="6"
                tools:listitem="@layout/item_doppelkopf_score" />

        <TextView
                android:id="@+id/emptyRoundsHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:gravity="center"
                android:text="@string/text_no_rounds"
                android:textAppearance="@style/TextAppearance.App.Meta"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/scoresRv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/scoresRv"
                tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottomPill"
                style="@style/Widget.App.BottomPill"
                android:layout_width="wrap_content"
                android:layout_marginBottom="@dimen/bottom_pill_bottom_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/chartAction"
                        style="@style/Widget.App.BottomPill.Action"
                        android:layout_width="@dimen/bottom_pill_action_width"
                        android:contentDescription="@string/title_statistics"
                        app:icon="@drawable/ic_chart_24dp" />

                <!-- Cradle for the centre button. -->
                <Space
                        android:layout_width="@dimen/bottom_pill_cradle_width"
                        android:layout_height="match_parent" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/undoAction"
                        style="@style/Widget.App.BottomPill.Action"
                        android:layout_width="@dimen/bottom_pill_action_width"
                        android:contentDescription="@string/description_undo"
                        app:icon="@drawable/ic_undo_24dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/editScoreButton"
                style="@style/Widget.App.CenterFab"
                android:contentDescription="@string/description_new_score"
                app:icon="@drawable/ic_add_24dp"
                app:layout_constraintBottom_toBottomOf="@id/bottomPill"
                app:layout_constraintEnd_toEndOf="@id/bottomPill"
                app:layout_constraintStart_toStartOf="@id/bottomPill"
                app:layout_constraintTop_toTopOf="@id/bottomPill" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
