<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything about a running Doppelkopf list that is not a round and not who is playing it,
  reached from the game screen's app bar: its name, its round count and its scoring mode. The
  four seats are next door in sheet_doppelkopf_player_seats.

  The scoring row offers the Doppelkopf modes, which is why this is its own sheet rather than a
  version of sheet_game_settings.

  Round-count chips are filled from DoppelkopfRoundCount.ALLOWED_VALUES at runtime; values below
  the number of rounds already played are disabled rather than hidden.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_sheet"
            android:clipToPadding="false">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

            <View
                    android:layout_width="38dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_drag_handle" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_game_settings"
                        android:textAppearance="@style/TextAppearance.App.AppBarTitle" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/closeButton"
                        style="@style/Widget.App.AppBar.IconButton"
                        android:contentDescription="@string/description_close"
                        app:icon="@drawable/ic_close_24dp"
                        app:iconTint="?attr/colorOutline" />

            </LinearLayout>

            <!-- List name -->
            <TextView
                    style="@style/Widget.App.Sheet.SectionLabel"
                    android:text="@string/title_list_name" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/listNameInput"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:counterEnabled="true"
                    app:counterMaxLength="20"
                    app:endIconMode="clear_text"
                    app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/listNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusedByDefault="false"
                        android:inputType="text"
                        android:maxLines="1"
                        tools:text="Doppelkopf 003" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Round count -->
            <TextView
                    style="@style/Widget.App.Sheet.SectionLabel"
                    android:text="@string/settingsRoundCountTitle" />

            <LinearLayout
                    android:id="@+id/roundCountRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            <TextView
                    android:id="@+id/roundCountHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.Meta"
                    android:visibility="gone"
                    tools:text="6 rounds already played"
                    tools:visibility="visible" />

            <!-- Scoring mode -->
            <TextView
                    style="@style/Widget.App.Sheet.SectionLabel"
                    android:text="@string/settingsScoringTitle" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/scoringSimple"
                        style="@style/Widget.App.Sheet.Chip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settingsDoppelkopfScoringSimple" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/scoringDetailed"
                        style="@style/Widget.App.Sheet.Chip"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/settingsDoppelkopfScoringDetailed" />

            </LinearLayout>

            <TextView
                    android:id="@+id/scoringHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.App.Meta"
                    tools:text="Win, levels and announcements only." />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    style="@style/Widget.App.Sheet.SaveButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="20dp"
                    android:text="@string/dialog_title_button_save" />

            <!--
              The running list is the one place the recent rows never show - the hero card
              holds it - so without this button it could not be deleted at all.
            -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteButton"
                    style="@style/Widget.App.DangerButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:text="@string/menu_delete_list"
                    app:icon="@drawable/ic_delete_24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
