    <style name="TextAppearance.App.M3.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
