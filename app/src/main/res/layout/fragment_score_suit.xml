<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <TextView
                android:id="@+id/suitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_marginTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/title_suit"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <GridLayout
                android:id="@+id/suitGridLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:useDefaultMargins="true"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:columnCount="2"
                android:rowCount="3"
                app:layout_constraintTop_toBottomOf="@id/suitTitle">

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardClubs"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:checkable="true"
                    android:focusable="true"
                    android:clickable="true"
                    app:checkedIcon="@null"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_columnWeight="1">

                <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/clubs" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSpades"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:checkable="true"
                    android:focusable="true"
                    android:clickable="true"
                    app:checkedIcon="@null"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_columnWeight="1">

                <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/spades" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHearts"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:checkable="true"
                    android:focusable="true"
                    android:clickable="true"
                    app:checkedIcon="@null"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_columnWeight="1">

                <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/hearts" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDiamonds"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:checkable="true"
                    android:focusable="true"
                    android:clickable="true"
                    app:checkedIcon="@null"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_columnWeight="1">

                <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/diamonds" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrand"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:checkable="true"
                    android:focusable="true"
                    android:clickable="true"
                    app:checkedIcon="@null"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_columnWeight="1">

                <TextView
                        android:id="@+id/textGrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/label_grand"
                        android:textAlignment="center" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNull"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:checkable="true"
                    android:focusable="true"
                    android:clickable="true"
                    app:checkedIcon="@null"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_columnWeight="1">

                <TextView
                        android:id="@+id/textNull"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/label_null"
                        android:textAlignment="center" />

            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>