<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. A plain vertical stack on the background colour: the illustration header, the
  overlapping sheet and the -36dp offset of the old layout are gone.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            tools:context=".library.LibraryFragment">

        <!--
          fillViewport is what lets the empty state have a centre: with it the column below
          is stretched to the height of the screen when it is shorter, so the weight on the
          empty block has something to take.
        -->
        <androidx.core.widget.NestedScrollView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="96dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <!--
              clipToPadding is off so the recent-lists RecyclerView can pull itself back out
              to the screen edges with a negative margin; everything else in here stays on
              the gutter.
            -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_side_padding"
                    android:paddingEnd="@dimen/screen_side_padding">

                <!-- 1. Header row -->
                <LinearLayout
                        android:id="@+id/headerRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                    <TextView
                            android:id="@+id/greeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.App.ScreenTitle"
                            tools:text="Guten Abend" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/settingsButton"
                            style="@style/Widget.App.AppBar.IconButton"
                            android:contentDescription="@string/title_settings"
                            app:icon="@drawable/ic_settings_24dp" />

                </LinearLayout>

                <!--
                  2. Game-type filters. Lists never mix, so this picks which game the whole
                  screen below is about: the running list, quick start and recently played all
                  follow it, and the centre button opens that game's setup sheet.
                -->
                <LinearLayout
                        android:id="@+id/gameTypeFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/filterSkat"
                            style="@style/Widget.App.FilterChip"
                            android:layout_width="wrap_content"
                            android:checked="true"
                            android:text="@string/label_game_type_skat" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/filterDoppelkopf"
                            style="@style/Widget.App.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/label_game_type_doppelkopf" />

                </LinearLayout>

                <!-- 3. Active-list hero card -->
                <include
                        android:id="@+id/activeList"
                        layout="@layout/view_active_list_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp" />

                <!-- Stands in for the hero card while no list of this game is running -->
                <include
                        android:id="@+id/noRunningList"
                        layout="@layout/view_no_running_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                <!-- 3. Quick start -->
                <TextView
                        android:id="@+id/quickStartLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="@string/title_quick_start"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel" />

                <include
                        android:id="@+id/quickStart"
                        layout="@layout/view_quick_start_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                <!-- 4. Recently played -->
                <LinearLayout
                        android:id="@+id/recentHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/title_recently_played"
                            android:textAppearance="@style/TextAppearance.App.SectionLabel" />

                    <TextView
                            android:id="@+id/showAllLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="8dp"
                            android:paddingEnd="0dp"
                            android:text="@string/title_show_all"
                            android:textAppearance="@style/TextAppearance.App.Meta"
                            android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/games_rv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/screen_side_padding_negative"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="@dimen/screen_side_padding_negative"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_game_preview" />

                <!--
                  5. Nothing recorded for this game yet. Everything above it except the
                  greeting and the filters is hidden, and the weight hands it the rest of the
                  screen so the prompt sits in the middle of it.
                -->
                <include
                        android:id="@+id/emptyState"
                        layout="@layout/view_empty_library"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone"
                        tools:visibility="visible" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- 5. Bottom bar: floating pill with a straddling centre FAB -->
        <com.google.android.material.card.MaterialCardView
                android:id="@+id/bottomPill"
                style="@style/Widget.App.BottomPill"
                android:layout_width="0dp"
                android:layout_marginStart="@dimen/bottom_pill_side_margin"
                android:layout_marginEnd="@dimen/bottom_pill_side_margin"
                android:layout_marginBottom="@dimen/bottom_pill_bottom_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/listsTab"
                        style="@style/Widget.App.BottomPill.Tab"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/title_library"
                        android:textColor="?attr/colorPrimary"
                        app:icon="@drawable/ic_lists_24dp"
                        app:iconTint="?attr/colorPrimary" />

                <!-- Cradle for the centre button. -->
                <Space
                        android:layout_width="@dimen/bottom_pill_cradle_width"
                        android:layout_height="match_parent" />

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/playersTab"
                        style="@style/Widget.App.BottomPill.Tab"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/title_players_short"
                        android:textColor="?attr/colorOutline"
                        app:icon="@drawable/ic_people_24dp"
                        app:iconTint="?attr/colorOutline" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/addButton"
                style="@style/Widget.App.CenterFab"
                android:contentDescription="@string/description_new_list"
                app:icon="@drawable/ic_add_24dp"
                app:layout_constraintBottom_toBottomOf="@id/bottomPill"
                app:layout_constraintEnd_toEndOf="@id/bottomPill"
                app:layout_constraintStart_toStartOf="@id/bottomPill"
                app:layout_constraintTop_toTopOf="@id/bottomPill" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
