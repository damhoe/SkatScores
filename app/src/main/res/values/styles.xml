<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      No android:fontFamily on the themes: it would override the text appearances' faces and
      weights. The type scale below sets the family instead.
    -->
    <style name="Theme.App" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="colorPrimaryDark">?attr/colorSecondary</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.M3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.M3.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.M3.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.M3.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.M3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.M3.LabelSmall</item>
        <item name="titleTextColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:listDivider">@drawable/list_divider</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="materialIconButtonOutlinedStyle">@style/Widget.App.Button.ToggleGroupIconButton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.OutlinedButton</item>
        <item name="chipStyle">@style/Widget.App.Chip.Suggestion</item>
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>
        <item name="collapsingToolbarLayoutStyle">@style/Widget.App.CollapsingToolbar</item>
        <item name="coloredAppBarLayoutStyle">@style/Widget.App.AppBarLayout.Colored</item>
        <item name="coloredToolbarStyle">@style/Widget.App.Toolbar.Colored</item>
    </style>

    <!-- Repeats the type scale: there is no common ancestor with Theme.App. Keep both in step. -->
    <style name="Theme.App.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.M3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.M3.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.M3.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.M3.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.M3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.M3.LabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="titleTextColor">?attr/colorPrimary</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="materialIconButtonOutlinedStyle">@style/Widget.App.Button.ToggleGroupIconButton.Dark</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.OutlinedButton</item>
        <item name="chipStyle">@style/Widget.App.Chip.Suggestion</item>
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>
        <item name="collapsingToolbarLayoutStyle">@style/Widget.App.CollapsingToolbar</item>
        <item name="coloredAppBarLayoutStyle">@style/Widget.App.AppBarLayout.Colored.Dark</item>
        <item name="coloredToolbarStyle">@style/Widget.App.Toolbar.Colored.Dark</item>
    </style>

    <!--
      Material's type scale hard-codes Roboto and components ignore the theme's font family,
      so each scale style is overridden with the family changed. Material takes the medium
      weight of the title and label styles from sans-serif-medium, which the swap drops, so
      those restate it as textFontWeight.
    -->
    <style name="TextAppearance.App.M3.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.App.M3.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.App.M3.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
    </style>

    <style name="TextAppearance.App.M3.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.App.M3.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="TextAppearance.App.M3.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/app_sans</item>
        <item name="android:fontFamily">@font/app_sans</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="Widget.App.CollapsingToolbar" parent="@style/Widget.Material3.CollapsingToolbar">
        <item name="titleEnabled">true</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="contentScrim">?attr/colorSurfaceVariant</item>
        <item name="statusBarScrim">?attr/colorSurfaceVariant</item>
        <item name="collapsedTitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="expandedTitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.CollapsingToolbar</item>
        <item name="titleCollapseMode">scale</item>
        <item name="expandedTitleMarginBottom">20dp</item>
        <item name="collapsedTitleTextAppearance">
            @style/TextAppearance.App.CollapsingToolbar.Collapsed
        </item>
        <item name="expandedTitleTextAppearance">
            @style/TextAppearance.App.CollapsingToolbar.Expanded
        </item>
    </style>
    <style name="TextAppearance.App.CollapsingToolbar.Expanded"
        parent="TextAppearance.App.M3.DisplayMedium">
    </style>
    <style name="TextAppearance.App.CollapsingToolbar.Collapsed"
        parent="TextAppearance.App.M3.TitleLarge">
    </style>
    <style name="ThemeOverlay.App.CollapsingToolbar" parent="">
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.App.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="Widget.App.AppBarLayout.Colored" parent="Widget.Material3.AppBarLayout">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar.Colored</item>
    </style>
    <style name="Widget.App.AppBarLayout.Colored.Dark" parent="Widget.Material3.AppBarLayout">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar.Colored.Dark</item>
    </style>
    <style name="Widget.App.Toolbar.Colored" parent="Widget.Material3.Toolbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar.Colored</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.ToolbarTitle</item>
        <item name="titleTextColor">?colorOnSecondaryContainer</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar.Colored" parent="">
        <item name="android:background">?attr/colorSurface</item>
        <item name="statusBarScrim">?attr/colorSurface</item>
    </style>

    <style name="TextAppearance.App.ToolbarTitle" parent="TextAppearance.App.M3.TitleLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.App.Toolbar.Colored.Dark" parent="Widget.App.Toolbar.Colored">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar.Colored.Dark</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.ToolbarTitle</item>
        <item name="titleTextColor">?colorOnSurfaceVariant</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar.Colored.Dark" parent="">
        <item name="colorSurface">?attr/colorSurfaceVariant</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
    </style>


    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar</item>
        <item name="titleTextColor">?attr/colorPrimary</item>
    </style>


    <style name="ThemeOverlay.App.Toolbar" parent="">
    </style>


<style name="RoundImageViewShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <style name="Widget.App.Button.ToggleGroupIconButton" parent="Widget.App.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.App.Button.ToggleGroupIconButton.Dark" parent="Widget.App.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.App.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
    </style>


<style name="Widget.App.Chip.Suggestion" parent="Widget.Material3.Chip.Suggestion.Elevated">
        <item name="android:textAppearance">@style/TextAppearance.App.Chip.Suggestion</item>
    </style>

    <style name="TextAppearance.App.Chip.Suggestion" parent="TextAppearance.App.M3.BodyMedium" />


<style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
    </style>


</resources>